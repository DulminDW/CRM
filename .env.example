# ==============================================================================
# WINDOW COMPANIES CRM - ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# 1. NEVER commit your actual .env or .env.local file to version control.
# 2. DO NOT put real keys, passwords, or service credentials in this file.
# 3. Only variables prefixed with VITE_ are bundled into client-side JavaScript.
#    ANY VITE_ VARIABLE IS ACCESSIBLE TO ANY USER WHO OPENS DEVTOOLS IN A BROWSER.
# 4. NEVER PUT SUPABASE SERVICE ROLE KEY, RESEND/SENDGRID API KEYS, OR DATABASE
#    CREDENTIALS IN ANY FILE ACCESSIBLE TO THE FRONTEND.
# ==============================================================================

# Application Environment Mode (development / staging / production)
VITE_APP_ENV=development

# Application Public Name
VITE_APP_NAME="WINDOW COMPANIES CRM"

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Client-safe Supabase URL (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://placeholder-project.supabase.co

# Client-safe Supabase Publishable / Anon Key (Public Key protected strictly by Postgres RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=placeholder-publishable-key-never-place-service-role-here

# ------------------------------------------------------------------------------
# SERVER-SIDE ONLY VARIABLES (Reference documentation only - NEVER in frontend)
# These will live strictly in Supabase Edge Functions / Vercel Serverless Functions:
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_KEY
# EMAIL_PROVIDER_API_KEY=YOUR_SERVER_ONLY_KEY
# VOICE_TRANSCRIPTION_API_KEY=YOUR_SERVER_ONLY_KEY
